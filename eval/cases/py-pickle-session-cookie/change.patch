+import base64
+import pickle
+
 SESSION_COOKIE = "session"
 
 
 def cookie_value(request):
     return request.cookies.get(SESSION_COOKIE, "")
+
+
+def load_session(request):
+    raw = base64.b64decode(cookie_value(request))
+    return pickle.loads(raw)
