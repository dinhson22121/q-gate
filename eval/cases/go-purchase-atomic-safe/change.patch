+	errInsufficientStock = errors.New("not enough stock")
+)
+
+func (s *ItemStore) Purchase(id int64, quantity int) (Item, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	item, ok := s.items[id]
+	if !ok {
+		return Item{}, errItemNotFound
+	}
+	if item.Stock < quantity {
+		return Item{}, errInsufficientStock
+	}
+	item.Stock -= quantity
+	s.items[id] = item
+	return item, nil
+}
