index 0000000..c3b64e1
--- /dev/null
+++ b/purchase_test.go
@@ -0,0 +1,91 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"testing"
+)
+
+func purchase(store *ItemStore, body string) *httptest.ResponseRecorder {
+	rec := httptest.NewRecorder()
+	req := httptest.NewRequest(http.MethodPost, "/items/purchase", strings.NewReader(body))
+	purchaseHandler(store)(rec, req)
+	return rec
+}
+
+func TestPurchaseDecrementsStock(t *testing.T) {
+	store := NewItemStore()
+	store.Add("Mug", 9.5, 5)
+
+	rec := purchase(store, `{"id":1,"quantity":2}`)
+
+	if rec.Code != http.StatusOK {
+		t.Fatalf("got %d %s", rec.Code, rec.Body.String())
+	}
+	var got Item
+	if err := json.Unmarshal(rec.Body.Bytes(), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got.Stock != 3 {
+		t.Fatalf("stock = %d, want 3", got.Stock)
+	}
+}
+
+func TestPurchaseRejectsBadRequests(t *testing.T) {
+	cases := map[string]struct {
+		body string
+		want int
+	}{
+		"zero quantity": {`{"id":1,"quantity":0}`, http.StatusBadRequest},
+		"unknown item":  {`{"id":99,"quantity":1}`, http.StatusNotFound},
+		"not enough":    {`{"id":1,"quantity":6}`, http.StatusConflict},
+		"bad json":      {`{`, http.StatusBadRequest},
+	}
+	for name, tc := range cases {
+		t.Run(name, func(t *testing.T) {
+			store := NewItemStore()
+			store.Add("Mug", 9.5, 5)
+
+			rec := purchase(store, tc.body)
+
+			if rec.Code != tc.want {
+				t.Fatalf("got %d, want %d", rec.Code, tc.want)
+			}
+			if stock := store.items[1].Stock; stock != 5 {
+				t.Fatalf("stock changed to %d", stock)
+			}
+		})
+	}
+}
+
+func TestConcurrentPurchasesNeverOversell(t *testing.T) {
+	const stock, buyers = 10, 50
+	store := NewItemStore()
+	store.Add("Mug", 9.5, stock)
+
+	var wg sync.WaitGroup
+	var mu sync.Mutex
+	succeeded := 0
+	for range buyers {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			if purchase(store, `{"id":1,"quantity":1}`).Code == http.StatusOK {
+				mu.Lock()
+				succeeded++
+				mu.Unlock()
+			}
+		}()
+	}
+	wg.Wait()
+
+	if succeeded != stock {
+		t.Fatalf("%d purchases succeeded, want %d", succeeded, stock)
+	}
+	if got := store.items[1].Stock; got != 0 {
+		t.Fatalf("stock = %d, want 0", got)
+	}
+}
