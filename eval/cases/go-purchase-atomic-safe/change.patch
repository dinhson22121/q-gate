+
+type purchaseRequest struct {
+	ID       int64 `json:"id"`
+	Quantity int   `json:"quantity"`
+}
+
+func purchaseHandler(store *ItemStore) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodPost {
+			w.Header().Set("Allow", http.MethodPost)
+			writeError(w, http.StatusMethodNotAllowed, "method not allowed")
+			return
+		}
+		var req purchaseRequest
+		decoder := json.NewDecoder(http.MaxBytesReader(w, r.Body, maxItemBodyBytes))
+		decoder.DisallowUnknownFields()
+		if err := decoder.Decode(&req); err != nil {
+			writeError(w, http.StatusBadRequest, "invalid JSON body")
+			return
+		}
+		if req.Quantity <= 0 {
+			writeError(w, http.StatusBadRequest, "quantity must be greater than zero")
+			return
+		}
+		item, err := store.Purchase(req.ID, req.Quantity)
+		switch {
+		case errors.Is(err, errItemNotFound):
+			writeError(w, http.StatusNotFound, err.Error())
+		case errors.Is(err, errInsufficientStock):
+			writeError(w, http.StatusConflict, err.Error())
+		default:
+			writeJSON(w, http.StatusOK, item)
+		}
 	}
 }
