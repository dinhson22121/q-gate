index 2cb6be2..92914d6 100644
--- a/src/image.ts
+++ b/src/image.ts
@@ -1,3 +1,17 @@
+import { execFile } from "node:child_process";
+import path from "node:path";
+
+const UPLOADS_DIR = "/srv/uploads";
+const SAFE_NAME = /^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}\.(png|jpe?g|gif)$/;
+
 export function outputName(input: string): string {
   return input.replace(/\.[^.]+$/, "") + ".png";
 }
+
+export function convertImage(name: string, done: (error: Error | null) => void): void {
+  if (!SAFE_NAME.test(name)) {
+    done(new Error("invalid file name"));
+    return;
+  }
+  execFile("convert", [path.join(UPLOADS_DIR, name), "out.png"], (error) => done(error));
+}
