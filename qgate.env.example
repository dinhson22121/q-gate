# =====================================================================================================
#  qgate setup file
#
#  1. Copy this file:      cp qgate.env.example qgate.env
#  2. Fill in at least:    CLAUDE_CODE_OAUTH_TOKEN and REPOS_PATH
#  3. Start:               docker compose up -d
#
#  qgate.env holds SECRETS. Never commit it: add "qgate.env" to your .gitignore, and restrict who can
#  read it:  chmod 600 qgate.env   (macOS / Linux).
#  Format: one VARIABLE=value per line, no quotes needed, no spaces around "=".
#  After editing, apply changes with:  docker compose up -d
# =====================================================================================================


# -----------------------------------------------------------------------------------------------------
#  Claude  (required)
# -----------------------------------------------------------------------------------------------------

# qgate runs the Claude Code CLI (`claude`, installed in the image) on your Claude subscription (Max/Pro):
# no Anthropic API key, no per-token bill. Reviews count against your subscription's usage limits; when the
# limit is reached qgate aborts the review ("waiting for session reset") instead of passing it.
#
# Option 1 (recommended): a long-lived subscription token. On the host run `claude setup-token`, paste it here.
# [SECRET] Prefer a Docker secret: leave it empty and set CLAUDE_CODE_OAUTH_TOKEN_FILE (see README).
CLAUDE_CODE_OAUTH_TOKEN=
# CLAUDE_CODE_OAUTH_TOKEN_FILE=/run/secrets/claude_oauth_token
#
# Option 2: log in inside the container once; the login is kept in the qgate-data volume:
#   docker compose exec qgate claude login
# Option 3: mount the host's ~/.claude read-only (docker-compose.override.example.yml). Exposes your Claude
# Code credentials to the container; on macOS they live in the Keychain, so use option 1 there.
#
# The token only ever reaches the qgate container; qgate-runner (where repository code runs) has no `claude`
# and no token.


# -----------------------------------------------------------------------------------------------------
#  Repositories  (required)
# -----------------------------------------------------------------------------------------------------

# Folder on THIS computer that contains your git repositories (searched up to 3 levels deep).
# It is mounted read-only: qgate never changes your code.
#   macOS:    /Users/me/code
#   Linux:    /home/me/code
#   Windows:  C:/Users/me/code      (forward slashes; the drive must be shared in Docker Desktop)
REPOS_PATH=


# -----------------------------------------------------------------------------------------------------
#  Review files for your coding agent
# -----------------------------------------------------------------------------------------------------

# Folder on THIS computer where qgate writes a review file after each scan (mounted read-write at /reviews;
# the only folder qgate writes to on your machine). Default: ./reviews next to docker-compose.yml.
# Create it first on every OS (mkdir -p ~/qgate-reviews): Docker cannot create it for you on macOS, and on
# Linux it would end up owned by root.
# Tip: point your coding agent at <REVIEWS_PATH>/<repo>/<branch>/latest.md, e.g. add to the repo's CLAUDE.md
# (or Cursor rules): "Before continuing work, read ~/qgate-reviews/shop-api/<branch>/latest.md and fix
# blocking items first." Branch names are sanitised: feature/ABC-1 -> feature-ABC-1.
# File name, formats (Markdown, optional JSON) and how many to keep: Settings page, "Review files".
#   macOS:    /Users/me/qgate-reviews
#   Linux:    /home/me/qgate-reviews
#   Windows:  C:/Users/me/qgate-reviews
# REVIEWS_PATH=/Users/me/qgate-reviews


# -----------------------------------------------------------------------------------------------------
#  Dashboard
# -----------------------------------------------------------------------------------------------------

# Port of the dashboard on this computer: http://localhost:<port>. Only reachable from this computer.
QGATE_DASHBOARD_PORT=8080

# [SECRET] Optional dashboard login token. Leave unset: qgate generates one on first start, keeps it in its data
# volume and prints the login link in `docker compose logs qgate` (or run: docker compose exec qgate qgate login-url).
# Set it only to choose the token yourself: at least 32 letters/digits/-_.~, e.g. the output of `openssl rand -hex 32`.
# QGATE_DASHBOARD_TOKEN=


# -----------------------------------------------------------------------------------------------------
#  Toolchains used to run your tests and linters
#  Installed on first start into a Docker volume (downloads are SHA-256/512 verified) and cached, so
#  later starts are instant. Changing a version installs it next to the old one and switches to it.
# -----------------------------------------------------------------------------------------------------

# Comma-separated list. Allowed: go, java, node, python, rust, quality. Use "none" for no toolchains.
# "java" includes Maven (and Gradle if QGATE_GRADLE_VERSION is set). "go" includes govulncheck and golangci-lint.
# "quality" installs gitleaks (secret scan) and osv-scanner (dependency vulnerabilities). It is added
# automatically when missing from this list (the quality checks are on by default; QGATE_QUALITY_ENABLED=false
# turns them off, QGATE_GITLEAKS_VERSION=none / QGATE_OSV_SCANNER_VERSION=none skip a tool).
QGATE_TOOLCHAINS=go,java,quality

# Go: "latest" (newest stable at first install, then kept), a minor such as 1.24, or exact 1.24.3.
QGATE_GO_VERSION=latest

# Java: Eclipse Temurin JDK major version (newest build of that major).
QGATE_JAVA_VERSION=21
# Maven: exact version, or "none" to skip it.
QGATE_MAVEN_VERSION=3.9.11
# Gradle: exact version such as 8.14.3; leave empty if your projects use ./gradlew (recommended).
QGATE_GRADLE_VERSION=

# Node.js: major version (newest release of that line) such as 24, or exact 24.11.1.
QGATE_NODE_VERSION=24

# Python (installed with uv): 3.13 or exact 3.13.5. Also needed for Jira provider "mcp" (uvx).
QGATE_PYTHON_VERSION=3.13

# Quality-gate tools: exact versions, or "none" to skip one (the check is then skipped with a note).
QGATE_GITLEAKS_VERSION=8.30.1
QGATE_OSV_SCANNER_VERSION=2.7.1
QGATE_GOVULNCHECK_VERSION=v1.10.0
QGATE_GOLANGCI_LINT_VERSION=2.15.0

# Rust: stable, beta, nightly or exact 1.90.0. Building crates needs a C linker: see README, "Toolchains".
QGATE_RUST_VERSION=stable


# -----------------------------------------------------------------------------------------------------
#  Jira  (optional: checks commits against the ticket's acceptance criteria)
# -----------------------------------------------------------------------------------------------------

# Turn Jira acceptance-criteria checks on (true/false). The ticket key (e.g. SHOP-123) is read from
# the branch name or commit message. Commits whose ticket has unmet criteria fail the gate.
# QGATE_JIRA_ENABLED=true   # optional: set here to lock it; otherwise toggle Jira on the Settings page

# Your Jira Cloud site, e.g. https://yourcompany.atlassian.net
JIRA_BASE_URL=
# Email of the Jira account the API token belongs to.
JIRA_EMAIL=
# [SECRET] API token: https://id.atlassian.com/manage-profile/security/api-tokens
# Docker-secret alternative: JIRA_API_TOKEN_FILE=/run/secrets/jira_api_token
JIRA_API_TOKEN=


# -----------------------------------------------------------------------------------------------------
#  Figma  (optional: checks changes against the Figma frames linked from the ticket's parent Story)
#  Turn it on in the Figma section of the Settings page (http://localhost:8080/settings).
# -----------------------------------------------------------------------------------------------------

# [SECRET] Figma personal access token (read-only file content is enough). qgate uses the Figma REST API:
# Figma's cloud MCP server only accepts OAuth from catalog-listed clients. You can also paste the token
# on the Settings page instead of putting it here.
# Docker-secret alternative: FIGMA_TOKEN_FILE=/run/secrets/figma_token
FIGMA_TOKEN=


# -----------------------------------------------------------------------------------------------------
#  Notifications  (optional)
# -----------------------------------------------------------------------------------------------------

# [SECRET] Slack incoming-webhook URL (anyone with it can post to your channel). Empty = disabled.
QGATE_WEBHOOK_URL=


# -----------------------------------------------------------------------------------------------------
#  Admin-only settings  (optional; read-only on the Settings page for security)
# -----------------------------------------------------------------------------------------------------

# Endpoints and commands that receive credentials cannot be changed over HTTP; set them here and restart.
# Path of the `claude` executable and the time limit of one `claude -p` run (seconds).
# QGATE_CLAUDE_BIN=claude
# QGATE_CLI_TIMEOUT_SECS=600
# QGATE_JIRA_MCP_COMMAND=uvx mcp-atlassian==0.23.1
# QGATE_JIRA_MCP_ENV_PASSTHROUGH=JIRA_URL,JIRA_USERNAME,JIRA_API_TOKEN
# QGATE_FIGMA_API_BASE_URL=https://api.figma.com
# QGATE_FIGMA_MCP_URL=https://mcp.figma.com/mcp
# Run the [[checks]] commands from each repository's .qgate.toml (true/false). The Settings page can only
# turn them off.
# QGATE_RUN_REPO_CHECKS=true
# Watch every git repository under the mounted folder (true) instead of only the ones imported on the
# Repositories page (false, default). Leave off so qgate never reviews a repository you did not import.
# QGATE_REPOS_AUTO_SCAN=false
# Settings toggles (also editable on /settings): quality tools and regression detection, both on by default.
# QGATE_QUALITY_ENABLED=true
# QGATE_REGRESSION_ENABLED=true
# Branch a pushed branch is compared against (merge-base); a push to this branch is never reviewed.
# Empty = auto-resolve origin/main then origin/master.
# QGATE_WATCH_BASE_BRANCH=main


# -----------------------------------------------------------------------------------------------------
#  Container user  (Linux only; leave as is on macOS and Windows)
# -----------------------------------------------------------------------------------------------------

# qgate runs as this user/group id. On Linux, set them to the output of `id -u` and `id -g` if your
# repositories are not readable by others. Changing them requires `docker compose up -d --build`.
QGATE_UID=1000
QGATE_GID=1000

# -----------------------------------------------------------------------------------------------------
#  Runner  (repository checks and generated tests run in the separate qgate-runner container)
# -----------------------------------------------------------------------------------------------------
# The runner gets none of the settings in this file (no Claude token, no API keys, no `claude` binary), cannot read qgate's
# database, config, review files or your repositories (only commit snapshots), and has no dashboard login. Its build caches (Go modules, ~/.m2, npm, pip, ...) live in the qgate-runner-cache volume.

# Memory cap for the runner, where your tests/linters run, e.g. 6g. Raise it for large Java/Gradle builds.
QGATE_MEMORY_LIMIT=6g
# Memory cap for the qgate service itself (reviews are network-bound). Default 1g.
# QGATE_SERVICE_MEMORY_LIMIT=1g
# CPU cap for the runner (also uncomment `cpus:` in docker/compose.qgate.yml). Must not exceed the cores
# of the Docker VM.
# QGATE_CPUS=2
# Commands the runner executes at the same time. Default 4.
# QGATE_RUNNER_MAX_JOBS=4
# Network of the runner. Default `bridge` (Docker's default network: dependency downloads work; the
# dashboard needs a login token the runner never gets). `none` = fully offline: checks/tests can then only
# use dependencies that are already in the runner cache (vendor them, or run once with `bridge` to fill the cache).
# QGATE_RUNNER_NETWORK=none
